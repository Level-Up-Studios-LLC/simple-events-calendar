# Pin line endings to LF so the sass build (which writes LF) does not create
# phantom line-ending diffs on Windows checkouts where core.autocrlf=true.
*.css   text eol=lf
*.scss  text eol=lf
*.js    text eol=lf
*.php   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.pot   text eol=lf
*.po    text eol=lf
*.xml   text eol=lf

# Binary assets — never normalize.
*.mo    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   binary
*.zip   binary
